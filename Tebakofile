# The SBOM lane (pydata#4, replicating the metanorma#168 feedstock
# template; tebako#1124's standing rules). The legs generate the
# CycloneDX 1.6 SBOM with the pinned tebako CLI's sbom verb (tebako#1120
# — activates when the tools pin reaches the release carrying it); the
# publish job attaches + signs the .cdx.json and runs the osv-scanner
# parse smoke (report-only). The smoke's tool pin lives HERE with the
# same discipline as the tools block (digest pinned, and cross-checked
# against the release's own osv-scanner_SHA256SUMS at fetch time).
sbom:
  osv_scanner:
    repo: "google/osv-scanner"
    version: "2.7.1"
    sha256:
      macos-arm64: "b22c02877a811c8f78956e8643efa554932b7378f590d13f8e97d4e9448a29f3"

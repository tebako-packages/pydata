# Feedstock recipe for pydata
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "pydata"
kind: app
summary: "pydata — the curated python data-science toolkit (numpy + pandas + matplotlib), pressed as one tebako payload on the tebako python runtime"

upstream:
  # A CURATED SET, not a single upstream package: the payload carries its
  # OWN version (the toolkit line), and the member pins below are the
  # requirements.in the locked closure resolves (tools/gen_closure is the
  # pip analog of the metanorma feedstock's gen_closure — pip download
  # with the leg's platform tags + --only-binary=:all:, then sha256 every
  # artifact into closure/<version>-<triplet>.txt; source builds are
  # NEVER a feedstock path, so an sdist-only member is a fail-closed
  # named error, never a compile).
  version: "0.1.0"
  members:
    - {pypi: "numpy", version: "2.5.5"}       # PyPI latest, 2026-11-22
    - {pypi: "pandas", version: "3.1.1"}      # PyPI latest, 2026-11-22
    - {pypi: "matplotlib", version: "3.11.2"} # PyPI latest, 2026-11-22
  source: "https://pypi.org"
  # Member floors: numpy requires_python >= 3.12, pandas/matplotlib >= 3.11
  # (PyPI-verified 2026-11-22); all three ship cp314 wheels for
  # manylinux_{2_17..}/musllinux, macosx_11_0+ (arm64/x86_64/universal2),
  # and win_amd64. The MANIFEST's runtime edge is the ABI line (~> 3.14.0),
  # not any range — the payload carries compiled members (numpy's BLAS
  # core, pandas' cython members, matplotlib's ft2font/kiwisolver/
  # contourpy/pillow), so spec 05 §5's native-extension law applies:
  # wrong line = named error, never a segfault.

build:
  system: pipstage         # stage a pip --target closure with a tebako runtime's own python
  runtime:
    engine: python
    version: "3.14.7"      # the staging + exec runtime (the ONE line every leg
                           # rides — the ABI edge stays uniform: the factory's
                           # windows-ucrt64 runtime exists only on the 3.14 line)
    tebako: "0.3.5"        # the runtime package's <ver> (the factory's VERSION)
                           # — the post-tebako#716 naming era
                           # (tebako-runtime-<ver>-python-<py>-<host>) with
                           # per-package manifest shards + .sha256 sidecars +
                           # OpenPGP .asc signatures + the .tfs.blksum facet;
                           # the windows package is exe + .dll + .tfs and the
                           # msys env image grants `windows_boot: materialize`,
                           # so a windows payload boots on its own platform.
    # RELEASE CHANNEL: the staging runtime and the CI test legs resolve the
    # factory RELEASE — tools/stage_runtime's release channel enumerates the
    # pinned tag's shards (gh release view), fetches the assets each shard
    # names, verifies every staged byte three ways (per-asset .sha256
    # sidecar ↔ staged bytes ↔ the shard's own digest fields + the filename
    # identity), and derives the TRIMMED manifest.json + SHA256SUMS.txt into
    # a file:// runtime mirror (spec 05 §2's download-base shape). NEVER a
    # hand-installed python.
    channel: release       # release (published factory tag) | run-artifacts (pre-publish proof builds)
    release: "v0.3.5"      # the factory release tag (release channel)
  # The closure's native members (the three flagship packages plus their
  # compiled transitive deps — contourpy, kiwisolver, pillow): staged from
  # PyPI wheels matching the staging runtime's ABI tag (cp314) and the
  # leg's triplet. Source builds of native members are NEVER a feedstock
  # path (audience law 1–3): gen_closure's --only-binary=:all: makes an
  # sdist resolution a named failure, and the per-member wheel assertion
  # below runs fail-closed.
  native_members: ["numpy", "pandas", "matplotlib"]
  # x86_64-windows-ucrt only: PyPI's win_amd64 wheels are MSVC-built and
  # the msys2/ucrt cpython of the tebako windows runtime cannot load them
  # (the xml2rfc lxml lesson — its compiled member stages from the msys2
  # package for the same reason), and PyPI publishes NO mingw wheels.
  # numpy/pandas/matplotlib are ALL compiled, so the windows leg stages
  # the whole stack from msys2's PREBUILT ucrt64 packages via pacman
  # (never a source build — pacman delivers signed binaries, the same
  # audience-law reading as the runtime factory's own windows support
  # set). tools/stage_msys2 copies the packages' site-packages members +
  # their PE import closure; tools/build assembles from that tree.
  windows_msys:
    python: "3.14"         # the msys2 ucrt64 python line — asserted against
                           # the runtime's ABI line (fail closed on drift)
    members:
      - "mingw-w64-ucrt-x86_64-python-numpy"
      - "mingw-w64-ucrt-x86_64-python-pandas"
      - "mingw-w64-ucrt-x86_64-python-matplotlib"
    # The transitive python deps the members import (pacman resolves them
    # as dependencies; stage_msys2 stages their site-packages entries
    # too). Drift from the real dep set fails loudly at the conformance
    # arms (import errors are named), never silently.
    closure_members:
      - "mingw-w64-ucrt-x86_64-python-contourpy"
      - "mingw-w64-ucrt-x86_64-python-cycler"
      - "mingw-w64-ucrt-x86_64-python-dateutil"
      - "mingw-w64-ucrt-x86_64-python-fonttools"
      - "mingw-w64-ucrt-x86_64-python-kiwisolver"
      - "mingw-w64-ucrt-x86_64-python-packaging"
      - "mingw-w64-ucrt-x86_64-python-pillow"
      - "mingw-w64-ucrt-x86_64-python-pyparsing"
      - "mingw-w64-ucrt-x86_64-python-pytz"
      - "mingw-w64-ucrt-x86_64-python-six"
      - "mingw-w64-ucrt-x86_64-python-tzdata"

platforms:
  # The second flagship's three desktop triplets (TODO.sota2/05): the
  # POSIX pair rides the PyPI wheel closure; the windows-ucrt leg rides
  # the factory's materialize tier + the msys2 prebuilt staging above.
  - aarch64-macos
  - x86_64-linux-gnu
  - x86_64-windows-ucrt

provides:
  entrypoints:
    - {name: "pydata", path: "/bin/pydata", version: "0.1.0"}
  executables: []          # no host-tier executables: the console script
                           # needs the interpreter (spec 32's spawn form)

ci:
  # The leg topology (host runner per triplet). No container legs in this
  # increment: the linux-gnu leg is host-native (this feedstock compiles
  # nothing — pipstage fetches wheels), macos + windows runner-native.
  hosts:
    aarch64-macos: "macos-15"
    x86_64-linux-gnu: "ubuntu-22.04"
    x86_64-windows-ucrt: "windows-latest"
  containers: {}

tools:
  repo: "tamatebako/tebako"
  release: "v2.8.83"          # pinned against the release's own SHA256SUMS
                              # (every pin below is verified two ways in CI:
                              # Tebakofile pin ↔ downloaded bytes ↔ release
                              # SHA256SUMS entry). The windows assets carry
                              # the .exe suffix.
  sha256:

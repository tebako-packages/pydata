#!/usr/bin/env bash
# tools/stage_runtime — stage the pinned tebako python runtime into a
# local file:// runtime MIRROR (spec 05 §2's download-base shape:
# <mirror>/v<tebako>/manifest.json + SHA256SUMS.txt + the exe/image
# assets), ready for TEBAKO_RUNTIME_MIRROR=file://<mirror> and the
# store's `runtimes: {python: …}` pin.
#
# Channel: release ONLY (the xml2rfc feedstock's run-artifacts channel —
# pre-publish factory proof builds — is deliberately not carried here;
# port it when a pre-publish proof is actually needed).
#
# The release channel rides the factory's SHARD model: the release serves
# per-package manifest shards (<stem>.manifest.json), per-asset .sha256
# sidecars and OpenPGP .asc signatures; the monolithic manifest.json /
# SHA256SUMS.txt are derived consumer-side (below). Shards are enumerated
# with `gh release view --json assets` and selected on the pin's EXACT
# version (variant lines like -jit are excluded — the recipe pins the
# plain build).
#
# Naming era (tebako#716): tebako >= 0.3.0 runtimes compose
# tebako-runtime-<tb>-python-<py>-<host> — the `python` language segment
# joins the name. This tool composes the era-2 spelling ONLY (the recipe
# pins 0.3.5); the lang-less <= 0.2.x spelling is not handled.
#
# Every staged byte is verified THREE ways: sidecar ↔ staged bytes ↔ the
# shard's own digest fields, plus the filename identity (a divergence
# anywhere is a named error, never a pick). The .tfs.blksum facet the
# shard names (spec 39's lazy-range block sums) is staged and verified
# the same way — the derived mirror carries it so no consumer re-derives
# it. The .abi sidecar tools/build consumes is FLOWED from the shard's
# own `abi` key (the factory's value, never re-authored — the release
# ships no .abi asset). The windows package is THREE artifacts
# (<stem>.exe + <stem>.dll + <stem>.tfs): the .dll is verified against
# its own sidecar ↔ the shard's `dll` facet, staged under its asset name,
# and additionally laid down under the facet's `install_as` PE name so
# the mirror's exe runs where it lies (the interpreter import resolves
# beside the exe).
#
# Inputs (env, defaults from Tebakofile — the SSOT; this script carries
# no version literals):
#   PY_V / RT_TEBAKO / RELEASE_TAG / FACTORY_REPO   the runtime pin
#   MIRROR         output mirror dir (default: out/runtime-mirror)
#   REL_DL         release download dir (default: out/release-assets)
#   HOST_IDS       space-separated host ids to stage (default: the recipe
#                  platforms' host ids — a CI leg stages only its own)
#
# Named errors everywhere; every byte that enters the mirror is hashed.
set -euo pipefail

FEEDSTOCK="$(cd "$(dirname "$0")/.." && pwd)"
# Native windows tools (ruby, gh, the runtime exe) cannot read Git Bash's
# POSIX path spellings — FEEDSTOCK goes windows-form where cygpath exists
# (inert on POSIX).
if command -v cygpath >/dev/null 2>&1; then FEEDSTOCK="$(cygpath -m "$FEEDSTOCK")"; fi
recipe() { ruby -ryaml -e "puts(YAML.load_file('$FEEDSTOCK/Tebakofile').dig(*ARGV) || '')" "$@"; }

PY_V="${PY_V:-$(recipe build runtime version)}"
RT_TEBAKO="${RT_TEBAKO:-$(recipe build runtime tebako)}"
CHANNEL="${CHANNEL:-$(recipe build runtime channel)}"
RELEASE_TAG="${RELEASE_TAG:-$(recipe build runtime release)}"
FACTORY_REPO="${FACTORY_REPO:-tamatebako/tebako-runtime-python}"
MIRROR="${MIRROR:-$FEEDSTOCK/out/runtime-mirror}"
REL_DL="${REL_DL:-$FEEDSTOCK/out/release-assets}"

step() { printf '\n== %s\n' "$*"; }
die() { echo "stage_runtime: $*" >&2; exit 1; }

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# triplet -> host_id (the factory's Platform::HOST_IDS; the runtime
# package names ride it) — asserted, never derived by formula elsewhere.
host_id_of() {
  case "$1" in
    x86_64-linux-gnu)  echo linux-gnu-x86_64 ;;
    aarch64-linux-gnu) echo linux-gnu-arm64 ;;
    x86_64-linux-musl) echo linux-musl-x86_64 ;;
    aarch64-linux-musl) echo linux-musl-arm64 ;;
    x86_64-macos)      echo macos-x86_64 ;;
    aarch64-macos)     echo macos-arm64 ;;
    x86_64-windows-ucrt) echo windows-ucrt64 ;;
    *) die "unknown TRIPLET: $1" ;;
  esac
}

# The recipe's matrix, translated to host ids (the default staging set —
# a CI leg overrides HOST_IDS to its own platform).
if [ -z "${HOST_IDS:-}" ]; then
  HOST_IDS=""
  for t in $(ruby -ryaml -e 'puts YAML.load_file(ARGV[0]).fetch("platforms").join(" ")' "$FEEDSTOCK/Tebakofile"); do
    HOST_IDS="$HOST_IDS $(host_id_of "$t")"
  done
  HOST_IDS="${HOST_IDS# }"
fi

[ "$CHANNEL" = "release" ] || die "unknown channel: $CHANNEL (release is the only channel this feedstock carries)"
[ -n "$RELEASE_TAG" ] || die "no factory release pinned (Tebakofile build.runtime.release)"

step "download $FACTORY_REPO release $RELEASE_TAG (python $PY_V, tebako $RT_TEBAKO — shard model, era-2 naming)"
mkdir -p "$REL_DL"
# Enumerate the release's assets once (gh's built-in --jq — no jq binary
# needed), then select each leg's shard on the pin's EXACT version
# (variant lines such as -jit are deliberately not staged).
listing="$REL_DL/.assets.listing"
if [ ! -s "$listing" ]; then
  gh release view "$RELEASE_TAG" --repo "$FACTORY_REPO" --json assets --jq '.assets[].name' > "$listing" \
    || die "cannot enumerate $FACTORY_REPO release $RELEASE_TAG"
fi
re_escape() { printf '%s' "$1" | sed 's/[].[\*^$]/\\&/g'; }
SHARDS="$REL_DL/.shards"
: > "$SHARDS"
for host_id in $HOST_IDS; do
  re="^tebako-runtime-$(re_escape "$RT_TEBAKO")-python-$(re_escape "$PY_V")-$(re_escape "$host_id")\.manifest\.json\$"
  grep -E "$re" "$listing" >> "$SHARDS" || true
done
sort -u -o "$SHARDS" "$SHARDS"
[ -s "$SHARDS" ] || die "no shard on $FACTORY_REPO $RELEASE_TAG matches python $PY_V (exact) on: $HOST_IDS"

# Per stem: the shard FIRST (its fields name every other asset — the
# exe/image/dll/blksum spellings are read from it, never composed), then
# the assets it names + their .sha256 sidecars. Fetches ride curl against
# the release-download URL (the URLs are public; the resolver fetches the
# same way). Idempotent per asset (a re-run re-verifies what it finds).
# Retried (a release-asset GET is a transient-prone edge fetch), and a
# failure reports curl's error text plus a probe of the status the URL
# actually answers — the CI log must name the failure mode.
dl() {
  if [ ! -f "$REL_DL/$1" ]; then
    local err; err="$(mktemp)"
    if ! curl -sS -L --fail --retry 3 --retry-delay 2 --retry-all-errors \
        -o "$REL_DL/$1" \
        "https://github.com/$FACTORY_REPO/releases/download/$RELEASE_TAG/$1" 2>"$err"; then
      local code
      code="$(curl -sSIL -o /dev/null -w '%{http_code}' \
        "https://github.com/$FACTORY_REPO/releases/download/$RELEASE_TAG/$1" 2>/dev/null || echo n/a)"
      die "release asset download failed: $1 (tag $RELEASE_TAG) — curl: $(cat "$err"); the URL answers: ${code:-n/a}"
    fi
  fi
}
# ruby-to-bash pipe boundary: NATIVE windows ruby's text-mode stdout
# terminates lines with CRLF, and `read` (unlike command substitution)
# keeps the \r — a tainted asset name malforms every consumer. binmode at
# the source; the shard_fields ruby below takes the same shield.
while IFS= read -r shard; do
  dl "$shard"
  while IFS= read -r asset; do
    dl "$asset"; dl "$asset.sha256"
  done < <(ruby -rjson -e '
    $stdout.binmode
    s = JSON.parse(File.read(ARGV[0]))
    abort("stage_runtime: #{ARGV[0]}: no filename field") unless s["filename"]
    abort("stage_runtime: #{ARGV[0]}: no image.filename field") unless s.dig("image", "filename")
    puts s["filename"], s["image"]["filename"]
    puts s["dll"]["filename"] if s.dig("dll", "filename")
    puts s["image"]["blksum"]["filename"] if s.dig("image", "blksum", "filename")
  ' "$REL_DL/$shard")
done < "$SHARDS"

step "assemble the mirror at $MIRROR/v$RT_TEBAKO"
DEST="$MIRROR/v$RT_TEBAKO"
rm -rf "$DEST"
mkdir -p "$DEST"
: > "$DEST/SHA256SUMS.txt"

while IFS= read -r shard; do
  stem="${shard%.manifest.json}"
  # The stem's host_id (the shard was selected by this leg's regex, so
  # exactly one HOST_IDS entry is its suffix — asserted, never assumed).
  host_of_stem=""
  for h in $HOST_IDS; do case "$stem" in *-"$h") host_of_stem="$h" ;; esac; done
  [ -n "$host_of_stem" ] || die "shard $shard carries no known host_id suffix ($HOST_IDS)"
  # 1. Shard-internal parity + identity (ONE ruby per shard): sidecar
  #    digests ↔ the shard's own digest fields, the identity triple, the
  #    stem recomposition (era-2 spelling: the python language segment;
  #    a factory rename or a wrong-line shard fails here loudly), the
  #    python line as the pin EXACTLY, and the windows dll / blksum
  #    facets the same way (install_as must be a bare PE name — the
  #    resolver's own guard, mirrored here). Prints, in fixed order: exe
  #    asset, image asset, dll asset (empty when none), install_as
  #    (empty when none), blksum asset (empty when none), and the abi —
  #    the shard's OWN key, flowed into the .abi sidecar tools/build
  #    consumes.
  shard_fields="$(ruby -rjson -e '
    $stdout.binmode
    shard_path, stem, rt, py_pin, host = ARGV
    shard = JSON.parse(File.read(shard_path))
    dir = File.dirname(shard_path)
    sidecar = ->(a) { File.read(File.join(dir, "#{a}.sha256")).split.first }
    checks = {
      "shard tebako_version" => [shard["tebako_version"], rt],
      "shard platform" => [shard["platform"], host],
      "shard exe sha256" => [shard["sha256"], sidecar.(shard["filename"])],
      "shard image sha256" => [shard.dig("image", "sha256"), sidecar.(shard.dig("image", "filename"))],
      "stem recomposition" => ["tebako-runtime-#{shard["tebako_version"]}-python-#{shard["python_version"]}-#{shard["platform"]}", stem],
    }
    checks["shard python_version"] = [shard["python_version"].to_s, py_pin] unless shard["python_version"].to_s == py_pin
    if (dll = shard["dll"])
      checks["dll sha256"] = [dll["sha256"], sidecar.(dll["filename"])]
      install_as = dll["install_as"].to_s
      if install_as.empty? || install_as.include?("/") || install_as.include?("\\")
        abort("stage_runtime: dll facet of #{shard["filename"]} carries an unusable install_as (#{install_as.inspect}) — the PE name must be a bare file name")
      end
    end
    if (blksum = shard.dig("image", "blksum"))
      checks["blksum sha256"] = [blksum["sha256"], sidecar.(blksum["filename"])]
    end
    checks.each { |k, (got, want)| got == want or abort("stage_runtime: #{k} divergence: #{got.inspect} != #{want.inspect}") }
    abi = shard["abi"] or abort("stage_runtime: shard for #{shard["filename"]} carries no abi key")
    puts shard["filename"], shard.dig("image", "filename"), shard.dig("dll", "filename").to_s, shard.dig("dll", "install_as").to_s, shard.dig("image", "blksum", "filename").to_s, abi
  ' "$REL_DL/$shard" "$stem" "$RT_TEBAKO" "$PY_V" "$host_of_stem")" || die "digest parity failed for $shard"
  { IFS= read -r exe_asset; IFS= read -r img_asset; IFS= read -r dll_asset; IFS= read -r install_as; IFS= read -r blksum_asset; IFS= read -r abi; } <<< "$shard_fields"
  # 2. The bytes against their .sha256 sidecars (the trust anchor) —
  #    exe, env image, the windows dll, and the blksum facet when the
  #    shard names them.
  for asset in "$exe_asset" "$img_asset" ${dll_asset:+"$dll_asset"} ${blksum_asset:+"$blksum_asset"}; do
    [ -f "$REL_DL/$asset" ] && [ -f "$REL_DL/$asset.sha256" ] \
      || die "incomplete release download: missing $asset or $asset.sha256"
    want="$(cut -d' ' -f1 < "$REL_DL/$asset.sha256")"
    got="$(sha256_file "$REL_DL/$asset")"
    [ "$got" = "$want" ] || die "SHA256 MISMATCH $asset: $got != $want (release sidecar)"
  done
  # 3. Stage the shard's bytes + sidecars + the shard itself.
  cp "$REL_DL/$exe_asset" "$REL_DL/$img_asset" "$REL_DL/$shard" "$DEST/"
  cp "$REL_DL/$exe_asset.sha256" "$REL_DL/$img_asset.sha256" "$DEST/"
  cat "$REL_DL/$exe_asset.sha256" "$REL_DL/$img_asset.sha256" >> "$DEST/SHA256SUMS.txt"
  if [ -n "$blksum_asset" ]; then
    cp "$REL_DL/$blksum_asset" "$REL_DL/$blksum_asset.sha256" "$DEST/"
    cat "$REL_DL/$blksum_asset.sha256" >> "$DEST/SHA256SUMS.txt"
    chmod 444 "$DEST/$blksum_asset" 2>/dev/null || true
  fi
  if [ -n "$dll_asset" ]; then
    cp "$REL_DL/$dll_asset" "$REL_DL/$dll_asset.sha256" "$DEST/"
    cat "$REL_DL/$dll_asset.sha256" >> "$DEST/SHA256SUMS.txt"
    chmod 444 "$DEST/$dll_asset" 2>/dev/null || true
    # The exe imports the dll under its PE name — lay a same-dir copy so
    # the mirror's exe runs where it lies (chmod is best-effort: under
    # Git Bash the mode bits are virtualized).
    if [ -e "$DEST/$install_as" ] && ! cmp -s "$DEST/$dll_asset" "$DEST/$install_as"; then
      die "dll install_as collision: $install_as already staged with different bytes"
    fi
    cp "$DEST/$dll_asset" "$DEST/$install_as"
    chmod 444 "$DEST/$install_as" 2>/dev/null || true
  fi
  printf '%s\n' "$abi" > "$DEST/$stem.abi"
  chmod 755 "$DEST/$exe_asset" 2>/dev/null || true
  chmod 444 "$DEST/$img_asset"
  echo "  $stem: $(sha256_file "$DEST/$exe_asset")"
done < "$SHARDS"

# The trimmed monolith, derived consumer-side: each shard IS its manifest
# entry; deterministic order by filename. A partial mirror never
# advertises bytes it does not carry — the derived index spans exactly
# the staged stems.
shard_paths=()
while IFS= read -r s; do shard_paths+=("$REL_DL/$s"); done < "$SHARDS"
ruby -rjson -e '
  out = ARGV.shift
  shards = ARGV.map { |p| JSON.parse(File.read(p)) }.sort_by { |s| s["filename"] }
  abort("stage_runtime: derived manifest is empty") if shards.empty?
  File.binwrite("#{out}.tmp", JSON.pretty_generate(shards) + "\n")
' "$DEST/manifest.json" "${shard_paths[@]}" || die "derived manifest.json failed"
mv "$DEST/manifest.json.tmp" "$DEST/manifest.json"
echo "  index: $DEST/manifest.json (derived from $(wc -l < "$SHARDS" | tr -d ' ') shard(s), trimmed to the staged stems) + SHA256SUMS.txt"

cat > "$MIRROR/stage.env" <<EOF
# written by tools/stage_runtime (release channel, release ${RELEASE_TAG})
# (the windows-ucrt64 exe carries the .exe suffix and ships a sibling
# .dll — also laid down under its install_as PE name when staged)
TEBAKO_RUNTIME_MIRROR=file://$MIRROR
RUNTIME_EXE=$DEST/tebako-runtime-$RT_TEBAKO-python-$PY_V-\$HOST_ID
RUNTIME_IMAGE=$DEST/tebako-runtime-$RT_TEBAKO-python-$PY_V-\$HOST_ID.tfs
EOF

step "staged: python $PY_V runtime (tebako $RT_TEBAKO), release channel"
echo "mirror:  $MIRROR"
echo "use:     export TEBAKO_RUNTIME_MIRROR=file://$MIRROR"
echo "         config.yaml runtimes: {python: {version: \"$PY_V\", tebako: \"$RT_TEBAKO\"}}"
